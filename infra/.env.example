# Template for the server's env file (production or staging). Copy it on the server, never here:
#
#   install -m 600 infra/.env.example /srv/qc/prod.env     # then edit /srv/qc/prod.env
#
# Every value below is a FAKE placeholder. Real values live only in the env file on the server.
# Variable names and meanings: infra/ENV.md.
#
# Rules for this file:
# - One KEY=value per line, no spaces around `=`. Wrap a value in single quotes only if it
#   contains `$` (Compose would otherwise try to expand it).
# - Leave an optional variable COMMENTED OUT rather than empty. An empty value is passed to the
#   container as "" and fails validation; a commented-out one stays unset and its default applies.

# ---------------------------------------------------------------------------------------------
# Stack (read by docker compose)
# ---------------------------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=qc-prod
# Public site (PWA, /api, WhatsApp webhook) and the admin console. DNS must point at the server.
QC_DOMAIN=app.example.invalid
QC_CONSOLE_DOMAIN=console.example.invalid
# Contact address for Let's Encrypt.
ACME_EMAIL=ops@example.invalid
# Where the static builds live on the host: <dir>/app (PWA) and <dir>/console.
QC_WWW_DIR=/srv/qc/www
# Images: <registry>/api:<tag>, /worker:<tag> and /poster-renderer:<tag>. `qc` when built on
# the host.
QC_IMAGE_REGISTRY=qc
# The tag is the git SHA, set per deploy by infra/scripts/deploy.sh and recorded in QC_STATE_DIR;
# infra/scripts/compose.sh uses the recorded one. Do not set it here.
# QC_IMAGE_TAG=
# Resource limits (defaults shown; size them to the VPS). Staging uses the same defaults, so it
# runs at launch size; leave these commented out there unless the host cannot give it 2 CPUs.
# QC_PROXY_CPUS=0.5
# QC_PROXY_MEMORY=256m
# QC_API_CPUS=2.0
# QC_API_MEMORY=1g
# QC_WORKER_CPUS=1.0
# QC_WORKER_MEMORY=512m
# QC_POSTGRES_CPUS=1.5
# QC_POSTGRES_MEMORY=1g
# QC_RENDERER_CPUS=1.0
# QC_RENDERER_MEMORY=768m

# ---------------------------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------------------------
# Hex only (openssl rand -hex 32), so each is safe inside a connection URL. Four different values.
# The superuser `qc`: only the db-roles step, backups, restores and hand-run psql use it.
POSTGRES_PASSWORD=replace-with-openssl-rand-hex-32
# The roles the services connect as (SEC-12, infra/postgres/roles.sql). The db-roles step sets
# these passwords on every `up`, so changing one here and running `up -d` rotates it. 24+ characters.
POSTGRES_MIGRATOR_PASSWORD=replace-with-openssl-rand-hex-32
POSTGRES_API_PASSWORD=replace-with-openssl-rand-hex-32
POSTGRES_WORKER_PASSWORD=replace-with-openssl-rand-hex-32

# ---------------------------------------------------------------------------------------------
# API and worker (shared)
# ---------------------------------------------------------------------------------------------
# production | staging. Production refuses fake messaging and test sign-in codes.
APP_ENV=production
# Public https origin used in links inside messages.
PUBLIC_WEB_BASE=https://app.example.invalid

# ---------------------------------------------------------------------------------------------
# Poster renderer (api, worker and the renderer itself)
# ---------------------------------------------------------------------------------------------
# Shared bearer token: the api and the worker send it, the renderer requires it. At least 24
# characters (openssl rand -hex 32). RENDERER_URL (http://poster-renderer:8090) and
# POSTER_STORAGE_DIR (the poster-files volume) are set by the compose file, not here.
RENDERER_TOKEN=replace-with-openssl-rand-hex-32

# ---------------------------------------------------------------------------------------------
# API only
# ---------------------------------------------------------------------------------------------
# Server processes in the api container, 1-8 (compose default 2). One Node process uses about one
# core: keep it equal to QC_API_CPUS, and allow about 350m of QC_API_MEMORY for each one.
# API_PROCESSES=2
# At least 32 characters (openssl rand -base64 48). Rotating it signs everyone out.
AUTH_SECRET=replace-with-openssl-rand-base64-48
# Extra browser origins allowed to call the API, comma-separated. Not needed for the PWA and the
# console: Caddy serves both with /api on their own origin.
# CORS_ORIGINS=https://other.example.invalid
# Staging only: a fixed six-digit sign-in code. Refused when APP_ENV=production.
# AUTH_FIXED_CODE=000000

# ---------------------------------------------------------------------------------------------
# Messaging (API: sign-in codes; worker: everything). Change request messaging-env-vars.
# ---------------------------------------------------------------------------------------------
# fake | live. Must be live in production.
MESSAGING_MODE=live
# test | live. Defaults to live when MESSAGING_MODE=live. Never test in production.
# CODE_DELIVERY_MODE=live
# Send the sign-in code by SMS when WhatsApp cannot deliver it (default true).
# CODE_SMS_FALLBACK=true
# Minutes the code message says the code works. Leave unset: the default (5) equals the API's
# fixed code lifetime, and a different value would tell people the wrong time (SEC-21).
# CODE_VALIDITY_MINUTES=5

# WhatsApp Cloud API (Meta). Required when MESSAGING_MODE=live.
WHATSAPP_PHONE_NUMBER_ID=replace-with-phone-number-id
WHATSAPP_ACCESS_TOKEN=replace-with-system-user-token
# Worker only: webhook signature secret and the verify token you enter in Meta's dashboard.
# Webhook callback URL to register with Meta: https://<QC_DOMAIN>/webhooks/whatsapp
# Both are required by the worker when APP_ENV=production.
WHATSAPP_APP_SECRET=replace-with-meta-app-secret
WHATSAPP_VERIFY_TOKEN=replace-with-random-verify-token
# Defaults to Meta's documented Graph API origin and version.
# WHATSAPP_GRAPH_BASE_URL=https://graph.example.invalid
# WHATSAPP_API_VERSION=v99.0

# SMS gateway (fallback for sign-in codes). Gateway not chosen yet.
# SMS_GATEWAY_URL=https://sms.example.invalid/send
# SMS_GATEWAY_KEY=replace-with-sms-gateway-key
# SMS_SENDER=QuranCircles

# Push, worker only. FCM: the service-account JSON on ONE line.
# FCM_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"replace-me","client_email":"replace-me@example.invalid","private_key":"replace-me"}
# APNs: the .p8 key as PEM text on one line, newlines written as \n.
# APNS_TEAM_ID=REPLACEME1
# APNS_KEY_ID=REPLACEME2
# APNS_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nreplace-me\n-----END PRIVATE KEY-----
# APNS_BUNDLE_ID=org.example.invalid.app
# APNS_PRODUCTION=true
# Web push for the PWA.
# VAPID_SUBJECT=mailto:ops@example.invalid
# VAPID_PUBLIC_KEY=replace-with-vapid-public-key
# VAPID_PRIVATE_KEY=replace-with-vapid-private-key

# Worker tuning (defaults shown; ranges in infra/ENV.md).
# Wake probe (starts a pass as soon as work is pending) and the safety-net full pass.
# WORKER_WAKE_MS=1000
# WORKER_POLL_MS=30000
# WhatsApp and SMS batches sent at once per node (push has its own settings below).
# WORKER_SEND_CONCURRENCY=4
# Push lane: batches at once per node, jobs per batch, sends at once per batch, idle poll.
# Push provider calls in flight per node = WORKER_PUSH_CONCURRENCY x WORKER_PUSH_PARALLEL.
# WORKER_PUSH_CONCURRENCY=4
# WORKER_PUSH_BATCH_SIZE=50
# WORKER_PUSH_PARALLEL=10
# WORKER_PUSH_POLL_MS=500
# Rows claimed and not finished, across all workers: push, then WhatsApp and SMS. Keep the push
# limit below what the senders finish within one lease (2000 is about 20 s at 100 a second).
# WORKER_PUSH_MAX_IN_FLIGHT=2000
# WORKER_MESSAGE_MAX_IN_FLIGHT=100
# How long a claim lasts before the row is handed out again (ms; outbox.worker_lost if it runs out).
# WORKER_LEASE_MS=300000
# How soon the dispatcher looks again while a lane is full or update pushes are being written.
# WORKER_BUSY_POLL_MS=1000
# Days ahead the worker's daily top-up keeps session occurrences (whole days 1 to 366).
# Reminders are built from occurrences, so this bounds how far ahead reminders exist.
# OCCURRENCE_HORIZON_DAYS=90
# WhatsApp spend limits, worker only (SEC-02). Defaults shown. The console's settings
# (whatsapp_daily_cap_per_person, whatsapp_city_monthly_budget) override the first two.
# Template messages one person may get per Pakistan day (0 to 5; 0 = no WhatsApp at all).
# WHATSAPP_DAILY_CAP=1
# Paid template messages one city may send per Pakistan calendar month (messages, not money).
# WHATSAPP_CITY_MONTHLY_BUDGET=3000
# Percentage of a city's budget at which whatsapp.city_budget_near is logged (1 to 100).
# WHATSAPP_BUDGET_ALERT_PERCENT=80

# ---------------------------------------------------------------------------------------------
# Backups and monitoring (read by the scripts in infra/backup and infra/monitoring, not by
# containers)
# ---------------------------------------------------------------------------------------------
QC_BACKUP_DIR=/srv/qc/backups
# age PUBLIC key (age1...). Backups are encrypted to it; the private key is NOT on this server.
QC_BACKUP_AGE_RECIPIENT=age1replacewiththeownerspublicagekey
QC_BACKUP_RETENTION_DAYS=14
QC_BACKUP_WEEKLY_RETENTION_WEEKS=8
# rclone remote for the second location, for example `offsite:qc-backups/prod`. Unset: no copy.
# QC_BACKUP_RCLONE_REMOTE=offsite:qc-backups/prod
# Restore checks only (staging): path to the age private key file.
# QC_BACKUP_AGE_IDENTITY=/srv/qc/keys/backup-restore.agekey
# Alerts: a URL that accepts a JSON POST {"text": "..."} (ntfy, Slack-compatible, etc.).
# QC_ALERT_WEBHOOK_URL=https://alerts.example.invalid/hook
# Disk usage percentage that raises an alert (default 85).
# QC_DISK_ALERT_PERCENT=85
# On the host that runs the weekly restore test (staging): alert when it is missing or failed.
# QC_EXPECT_RESTORE_CHECK=1
# Where the restore test fetches backups from (default: QC_BACKUP_RCLONE_REMOTE).
# QC_BACKUP_RESTORE_SOURCE=offsite:qc-backups/prod

# Deploys (infra/scripts/deploy.sh). Current and previous image tags and monitor state.
# QC_STATE_DIR=/srv/qc/state
# 1 = pull images from a registry instead of building on the server.
# QC_DEPLOY_PULL=1
# Staging only: skip the pre-deploy backup.
# QC_DEPLOY_SKIP_BACKUP=1
