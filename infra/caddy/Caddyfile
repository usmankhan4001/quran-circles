# Production reverse proxy (WP10). Caddy obtains and renews TLS certificates automatically for
# both site addresses. Values come from the proxy service's environment (infra/.env):
#   QC_DOMAIN          public site: the PWA, /api and the WhatsApp webhook
#   QC_CONSOLE_DOMAIN  admin console: its static build and /api
#   ACME_EMAIL         contact address for the certificate authority
#
# Paths:
#   /api/*               -> api:3000, with the /api prefix removed (/api/v1/config -> /v1/config,
#                           /api/health -> /health). Clients use https://<domain>/api as baseUrl.
#   /webhooks/whatsapp   -> worker:8081 (Meta's callback URL: https://<QC_DOMAIN>/webhooks/whatsapp)
#   everything else      -> static files, falling back to index.html for client-side routes
#
# The worker's /healthz is deliberately not routed: it is checked inside the stack only.
# No access log is written: request URIs can carry the webhook verify token in the query string.
#
# Security headers (SEC-10). Every response: HSTS, nosniff, Referrer-Policy, Permissions-Policy and
# X-Frame-Options DENY. Content-Security-Policy differs by what is served:
#   /api/* and /webhooks/*  JSON, CSV and downloads: nothing may load or frame them.
#   PWA (QC_DOMAIN)         its own files; the Quran text from api.alquran.cloud
#                           (packages/content); Google Maps for the Nearby map (the Maps
#                           JavaScript API's documented allowlist: scripts, tiles, styles, fonts,
#                           the worker it starts from a blob: URL, and its eval). Web push needs
#                           nothing here: the push service talks to the browser, not to the page.
#   console                 its own files only (fonts are bundled; downloads are blob: URLs). Zod's
#                           start-up probe for eval is refused and logged once; zod falls back.
# style-src keeps 'unsafe-inline' on the PWA: Expo's index.html has an inline reset style and
# Google Maps sets inline styles. No site allows inline or third-party script beyond the above.
# The PWA and the console call the api at /api on their own origin, so connect-src 'self' covers
# it; an api on another origin would need adding here.
# Referrer-Policy stays strict-origin-when-cross-origin: the Maps key is restricted by referrer.
{
	email {$ACME_EMAIL}
	# The admin endpoint is used by `caddy reload` and the container health check only.
	admin 127.0.0.1:2019
}

(common) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		-Server
	}
}

# CSP for responses that are data, not pages: the api and the webhook.
(csp-data) {
	header Content-Security-Policy "default-src 'none'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'"
}

(api) {
	handle_path /api/* {
		import csp-data
		request_body {
			max_size 10MB
		}
		# No active health checks here: with one upstream they only turn a restart into extra
		# seconds of 503s. Container health is Docker's job (see the compose file).
		reverse_proxy api:3000
	}
}

(spa) {
	handle {
		root * /srv/www/{args[0]}
		# Hashed build assets can be cached for a long time; everything else (index.html and the
		# client-side routes that fall back to it) is revalidated on every load.
		@assets path /assets/* /_expo/static/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@pages not path /assets/* /_expo/static/*
		header @pages Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}

{$QC_DOMAIN} {
	import common
	header Permissions-Policy "camera=(), microphone=(), geolocation=(self), payment=(), usb=(), serial=(), bluetooth=(), browsing-topics=()"
	@app not path /api/* /webhooks/*
	header @app Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-eval' blob: https://*.googleapis.com https://*.gstatic.com https://*.google.com https://*.ggpht.com https://*.googleusercontent.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob: https://tile.openstreetmap.org https://*.googleapis.com https://*.gstatic.com https://*.google.com https://*.googleusercontent.com https://*.ggpht.com; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://api.alquran.cloud https://*.googleapis.com https://*.google.com https://*.gstatic.com data: blob:; frame-src https://*.google.com; worker-src 'self' blob:; manifest-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
	import api

	handle /webhooks/whatsapp {
		import csp-data
		request_body {
			max_size 1MB
		}
		reverse_proxy worker:8081
	}

	import spa app
}

{$QC_CONSOLE_DOMAIN} {
	import common
	header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), serial=(), bluetooth=(), browsing-topics=()"
	@console not path /api/*
	header @console Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
	import api
	import spa console
}
