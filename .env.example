# Copy to .env for local development. Never commit .env.
# The production and staging template is infra/.env.example; every name is in infra/ENV.md.
# Development-only credentials matching infra/docker-compose.dev.yml.
DATABASE_URL=postgres://qc:qc@localhost:5432/qc
PORT=3000

# API only. AUTH_SECRET needs 32+ characters; AUTH_FIXED_CODE is a six-digit test code.
# AUTH_SECRET=
# AUTH_FIXED_CODE=
# AUTH_TRUST_PROXY=
# TRUST_PROXY=
# CORS_ORIGINS=

# Messaging. Names only, commented out so an empty value never overrides a default.
# Uncomment and set real values in your own .env, never here.
# Used by both the API and the worker.
# APP_ENV=
# MESSAGING_MODE=
# CODE_DELIVERY_MODE=
# CODE_SMS_FALLBACK=
# CODE_VALIDITY_MINUTES=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=
# SMS_GATEWAY_URL=
# SMS_GATEWAY_KEY=
# SMS_SENDER=

# Worker only.
# WHATSAPP_APP_SECRET=
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_GRAPH_BASE_URL=
# WHATSAPP_API_VERSION=
# FCM_SERVICE_ACCOUNT_JSON=
# APNS_TEAM_ID=
# APNS_KEY_ID=
# APNS_PRIVATE_KEY=
# APNS_BUNDLE_ID=
# APNS_PRODUCTION=
# VAPID_SUBJECT=
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# WORKER_HTTP_PORT=
# WORKER_POLL_MS=
# WORKER_SEND_CONCURRENCY=
# OCCURRENCE_HORIZON_DAYS=
# PUBLIC_WEB_BASE=

# App builds (read at build time by the Expo apps; public, not secrets).
# EXPO_PUBLIC_API_URL=https://example.invalid/api
# EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
# EXPO_PUBLIC_VAPID_PUBLIC_KEY=
