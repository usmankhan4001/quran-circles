# Copy to .env for local development. Never commit .env.
# Development-only credentials matching infra/docker-compose.dev.yml.
DATABASE_URL=postgres://qc:qc@localhost:5432/qc
PORT=3000

# Messaging. Names only, commented out so an empty value never overrides a default.
# Uncomment and set real values in your own .env, never here.
# Used by both the API and the worker.
# APP_ENV=
# MESSAGING_MODE=
# CODE_DELIVERY_MODE=
# CODE_SMS_FALLBACK=
# CODE_VALIDITY_MINUTES=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=
# SMS_GATEWAY_URL=
# SMS_GATEWAY_KEY=
# SMS_SENDER=

# Worker only.
# WHATSAPP_APP_SECRET=
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_GRAPH_BASE_URL=
# WHATSAPP_API_VERSION=
# FCM_SERVICE_ACCOUNT_JSON=
# APNS_TEAM_ID=
# APNS_KEY_ID=
# APNS_PRIVATE_KEY=
# APNS_BUNDLE_ID=
# APNS_PRODUCTION=
# VAPID_SUBJECT=
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# WORKER_HTTP_PORT=
# WORKER_POLL_MS=
# WORKER_SEND_CONCURRENCY=
# PUBLIC_WEB_BASE=
