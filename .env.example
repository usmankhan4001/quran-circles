# Copy to .env for local development. Never commit .env.
# The production and staging template is infra/.env.example; every name is in infra/ENV.md.
# Development-only credentials matching infra/docker-compose.dev.yml. Locally everything uses the
# dev superuser; servers use separate least-privilege roles (infra/postgres/roles.sql).
DATABASE_URL=postgres://qc:qc@localhost:5432/qc
PORT=3000

# API only. AUTH_SECRET needs 32+ characters; AUTH_FIXED_CODE is a six-digit test code.
# API_PROCESSES is how many server processes to run (1-8, default 1 locally; 2 in production).
# API_PROCESSES=
# AUTH_SECRET=
# AUTH_FIXED_CODE=
# AUTH_TRUST_PROXY=
# TRUST_PROXY=
# CORS_ORIGINS=
# First national admin, invited by the API at start-up when none exists (email and phone go
# together); CODE_TO is the mailbox that identity's sign-in codes are delivered to instead.
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_PHONE=
# BOOTSTRAP_ADMIN_CODE_TO=

# Messaging. Names only, commented out so an empty value never overrides a default.
# Uncomment and set real values in your own .env, never here.
# Used by both the API and the worker.
# APP_ENV=
# MESSAGING_MODE=
# CODE_DELIVERY_MODE=
# CODE_SMS_FALLBACK=
# CODE_VALIDITY_MINUTES=5
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=
# SMS_GATEWAY_URL=
# SMS_GATEWAY_KEY=
# SMS_SENDER=

# Worker only.
# WHATSAPP_APP_SECRET=
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_GRAPH_BASE_URL=
# WHATSAPP_API_VERSION=
# FCM_SERVICE_ACCOUNT_JSON=
# APNS_TEAM_ID=
# APNS_KEY_ID=
# APNS_PRIVATE_KEY=
# APNS_BUNDLE_ID=
# APNS_PRODUCTION=
# VAPID_SUBJECT=
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# WORKER_HTTP_PORT=
# WORKER_WAKE_MS=
# WORKER_POLL_MS=
# WhatsApp and SMS only; push uses the WORKER_PUSH_* settings.
# WORKER_SEND_CONCURRENCY=
# Push lane and claim limits (defaults 4, 50, 10, 500, 2000, 100, 300000, 1000); see infra/ENV.md.
# WORKER_PUSH_CONCURRENCY=4
# WORKER_PUSH_BATCH_SIZE=50
# WORKER_PUSH_PARALLEL=10
# WORKER_PUSH_POLL_MS=500
# WORKER_PUSH_MAX_IN_FLIGHT=2000
# WORKER_MESSAGE_MAX_IN_FLIGHT=100
# WORKER_LEASE_MS=300000
# WORKER_BUSY_POLL_MS=1000
# OCCURRENCE_HORIZON_DAYS=
# WhatsApp spend limits (defaults 1, 3000, 80); see infra/ENV.md.
# WHATSAPP_DAILY_CAP=1
# WHATSAPP_CITY_MONTHLY_BUDGET=3000
# WHATSAPP_BUDGET_ALERT_PERCENT=80
# PUBLIC_WEB_BASE=

# Poster renderer (the worker calls it, the api serves the files; the renderer requires the same
# token outside development). Fake placeholders; production sets RENDERER_URL and
# POSTER_STORAGE_DIR in infra/docker-compose.prod.yml.
# RENDERER_URL=http://localhost:8090
# RENDERER_TOKEN=replace-with-openssl-rand-hex-32
# POSTER_STORAGE_DIR=/tmp/qc-posters

# App builds (read at build time by the Expo apps; public, not secrets).
# EXPO_PUBLIC_API_URL=https://example.invalid/api
# EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
# EXPO_PUBLIC_VAPID_PUBLIC_KEY=
